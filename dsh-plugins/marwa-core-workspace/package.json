{
    "name":  "@local/marwa-core-workspace",
    "version":  "1.3.0",
    "private":  true,
    "type":  "module",
    "description":  "غرفة عمليات مروة — Native DSH UI: 4-zone workspace + 10 live Agent Presets + Zero-Click session routing",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "bridge/dsh_bridge.py",
                  "locale/*.json",
                  "icon.svg",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ]
                           }
            }
}
# =====================================================================
# Notebook v2 — نموذج فقط. القيم الحقيقية تُضاف إلى  G:\Marwa-Bot\.env
# (الجذر) — config.py يقرأها من هناك أولًا ثم يسمح بتجاوزها من ملف
# .env داخل المشروع. لا تُcommit أي قيمة حقيقية أبدًا (AGENT.md).
# =====================================================================

# --- هوية العقدة (كل جهاز يكتب اسمه) ---
NODE_ID=LAPTOP              # LAPTOP على Surface Pro 4 / WORKSHOP على جهاز الورشة
NODE_ROLE=surface_laptop    # surface_laptop | workshop_desktop

# --- بوت أفكري المستقل ---
TELEGRAM_AFKARY_TOKEN=1234567890:AAF-your-token-here
TELEGRAM_AFKARY_USERNAME=@Afkary22Bot
OWNER_TELEGRAM_ID=561770354     # الردّ على المالك فقط — أي مستخدم آخر يُتجاهل صامتًا

# --- قاعدة البيانات المشتركة (Supabase PostgreSQL + pgvector) ---
# الأفضلية: NB2_DB_URL ثم POOLER_URL ثم DIRECT_URL ثم DATABASE_URL من .env الجذر
NB2_DB_URL=postgresql://postgres.project:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# --- تشفير مفاتيح مزودي الـAI داخل القاعدة (Fernet master key) ---
AI_VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- بوابة استقبال تقارير الوكلاء / لقطات الـPOS ---
NB2_INGEST_TOKEN=nb2-random-secret-for-agents

# --- لقطة الـRetail (قراءة فقط من قاعدة POS — على جهاز الورشة فقط) ---
NB2_POS_DB_PATH=G:\path\to\pos_data.db

# --- سلوك استباقي ---
NB2_MORNING_BRIEFING_AT=08:00
NB2_RADAR_STAGNANT_DAYS=7

# --- الويب ---
NB2_PORT=8110

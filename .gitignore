# ==============================================================================
# Marwa-Bot .gitignore — الحماية من تسريب الأسرار والبيانات
# Owner order 2026-10-14: this file MUST protect .env, LAPTOP_SECRET_KIT.md,
# database files and backups. Never loosen it without an explicit owner decision.
# ==============================================================================

# ---------- SECRETS: ممنوع دخولها المستودع نهائياً ----------
.env
.env.*
!.env.example
LAPTOP_SECRET_KIT.md
*.key
*.pem
*.p12
*.pickle
token.json
token.pickle
credentials*.json
client_secret*.json
client_secret_*.json
*serviceAccount*.json
firebase_service_account.json
*.private.json

# ---------- AI GATEWAY: مفاتيح مزودي الذكاء الاصطناعي + عداد الاستهلاك ----------
# أمر المالك 2026-10-21 (Enterprise AI Gateway) — ممنوع دخولها المستودع نهائياً
workspaces/vision_coder/active_workspaces/ai_providers.json
workspaces/vision_coder/active_workspaces/ai_usage.json

# ---------- DATABASES + BACKUPS: البيانات تُبنى من السحابة ولا تُرفع ----------
*.db
*.db-shm
*.db-wal
*.db.bak
*.db.bak-*
*.bak
*.bak-*
*.bak_*
*.bak*
*.sqlite
*.sqlite3
backup/
Backups/
backups/
*.dump

# ---------- LOGS + RUNTIME STATE ----------
*.log
logs/
runtime_logs/
_last_backup.txt
telegram_import_now.flag
# RASED autosync daily marker (local sync gate — لا يُتتبع)
.rased_last_sync

# ---------- SCAN/DIAGNOSTIC SCRATCH (مخلفات فحص مؤقتة — لا تُرفع) ----------
/_*.py
/_error_report_jin.txt
/output.txt
/orders_output.txt
/client_names.txt
[ ]archive_preoct.py

# ---------- NOTEBOOK RUNTIME (بيانات النوتبوك محلية ولا تُرفع) ----------
notebook/data/

# ---------- DSH DEV SCRATCH (قوالب ومراجع تطوير إضافات DSH — عمل مؤقت لا يُرفع) ----------
.dsh_dev/

# ---------- PYTHON ----------
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ---------- NODE (تبعيات بتحمّل ثاني، مش بتتخزن في git) ----------
node_modules/
*.tsbuildinfo
.npm/


# ---------- HEAVY LOCAL-ONLY TREES (نسخ اختبار وصور وأرشيفات) ----------

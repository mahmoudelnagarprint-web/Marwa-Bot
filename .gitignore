/agent/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
# Aider session artifacts (مؤقتة - لا تُرفع)
.aider*

# ---------- LEAD/VISION SCRATCH (اختبارات مؤقّتة — مرجع تشخيص، لا تُرفع) ----------

# Marwa-Bot environment template — انسخه إلى .env واملأ القيم الحقيقية
# القيم الحقيقية موجودة في LAPTOP_SECRET_KIT.md المحلي (محمي بـ.gitignore)
# أو من أمر: python tools/laptop_sync.py --restore-env (لو الخزينة السحابية فيها نسخة)

# هوية الجهاز — WORKSHOP للورشة | LAPTOP للابتوب (يقرؤها tools/laptop_sync.py)
NODE_ID="LAPTOP"

# مسار القاعدة الحية (ورشة فقط — اللابتوب يتركه فارغاً)
# LIVE_DB_PATH="G:\ai\Elnagar POS\pos_data.db"

# --- Supabase (المرآة + خزينة العقل system_brain_sync) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...>"
SUPABASE_SECRET_KEY="sb_secret_<...>"
# الأسماء القديمة المكافئة (لو أردت استخدامها): SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# --- Telegram: بوت البرنامج (المستقبِل الوحيد = الويب هوك السحابي؛ poller محلي متوقف) ---
TELEGRAM_BOT_TOKEN="<bot-token>"
TELEGRAM_BOT_USERNAME="@<bot-username>"
OWNER_TELEGRAM_ID="<owner-chat-id>"
ALLOWED_CHAT_IDS="<owner-chat-id>"

# --- Dahl (استدعاءات الذكاء الاصطناعي للعقل السحابي) ---
DAHL_API_URL="https://inference.dahl.global/v1"
DAHL_API_KEY="dahl_<...>"
DAHL_MODEL="default-model"

# --- محرك المزامنة: الفاصل الزمني بالثواني ---
SYNC_INTERVAL_SECONDS="60"

# --- الاتصال المباشر بقاعدة Supabase (صلاحية المالك 2026-10-14 — لمحرك الترحيلات) ---
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"
POOLER_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
SUPABASE_ACCESS_TOKEN="sbp_<...>"
